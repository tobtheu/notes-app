# ============================================================
# Lama Notes — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ---- Supabase / GoTrue (Auth + REST) -----------------------
# In development (VPS HTTPS): https://api.lamanotes.de
VITE_SUPABASE_URL=https://api.lamanotes.de
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Electric -----------------------------------------------
# In development (VPS HTTPS): https://sync.lamanotes.de
VITE_ELECTRIC_URL=https://sync.lamanotes.de

# ---- Docker Compose (Electric service) ----------------------
# Direct Postgres connection from Supabase:
# Supabase → Project Settings → Database → Session Pooler (direct)
ELECTRIC_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Generate with: openssl rand -hex 32
ELECTRIC_SECRET_KEY_BASE=your-secret-key-base-here

# Supabase JWT Secret:
# Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
