{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lama Notes",
  "version": "0.7.12",
  "identifier": "com.tobtheu.notizapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "resizable": true,
        "fullscreen": false,
        "width": 1080,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/local_assets/**",
          "$DOCUMENT/**/.assets/**",
          "$HOME/**/.assets/**"
        ]
      },
      "csp": "default-src 'self' tauri: http://localhost:* http://127.0.0.1:*; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: local-asset: https: data: blob:; font-src 'self' data: https:; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* https://api.lamanotes.de https://sync.lamanotes.de https://*.supabase.co wss://*.supabase.co;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "infoPlist": "Info.ios.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tobtheu/notes-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NkYxMzA1NDU1MzY0MzcKUldRM1pGTkZCUk52aFZTLzN1NWkzNWdiekh6OVFyc2NXTjVneVA5amUyZU04TnpvN2EvekJwLzUK"
    }
  }
}